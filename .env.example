# ============================================================================
# CHECKOUT-CORE v1.2.0 — PCI-DSS v4.0.1 & ECOSYSTEM CONFIGURATION TEMPLATE
# Copy to .env for local testing. NEVER commit raw cryptographic keys to Git.
# ============================================================================

NODE_ENV=production
SERVICE_NAME=checkout-core
SERVICE_VERSION=1.2.0

# 1. PCI-DSS v4.0.1 Tokenization Vault (AES-256-GCM Envelope Encryption)
KMS_MASTER_KEY_ID=arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-000000000000
PAN_VAULT_KEY_ROTATION_DAYS=90
PAN_HASH_PEPPER_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 2. Edge Velocity Limiter & Anti-Card-Testing Guardrails
VELOCITY_WINDOW_MS=60000
VELOCITY_MAX_ATTEMPTS_PER_PAN=5
VELOCITY_MAX_ATTEMPTS_PER_IP=20

# 3. Multi-Acquirer Saga & Circuit Breaker Thresholds
PRIMARY_ACQUIRER_ID=stripe_us_primary
SECONDARY_ACQUIRER_ID=adyen_us_failover
ACQUIRER_REQUEST_TIMEOUT_MS=2500
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
ISO8583_MAX_SOFT_DECLINE_RETRIES=3

# 4. Cross-Service Transactional Outbox (Sync -> ledger-vault & refund-guard)
LEDGER_VAULT_INGEST_URL=https://ledger-vault.internal.svc/v1/events/ingest
REFUND_GUARD_SYNC_URL=https://refund-guard.internal.svc/v1/captures/register
ECOSYSTEM_HMAC_SIGNING_SECRET=replace_with_64_char_hex_shared_hmac_secret_for_event_signing
OUTBOX_REPLAY_TOLERANCE_MS=300000
OUTBOX_BATCH_DRAIN_LIMIT=100
